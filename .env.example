# ─────────────────────────────────────────────────────────────────────────────
# InvoiceHive — Environment Variables Template
# Copy this to .env and fill in your actual values
# DO NOT commit .env to git — it contains secrets!
# ─────────────────────────────────────────────────────────────────────────────

# ══════════════════════════════════════════════════════════════════════════════
# APPLICATION
# ══════════════════════════════════════════════════════════════════════════════
NODE_ENV=development
CLIENT_URL=http://localhost:3000
API_URL=http://localhost

# ══════════════════════════════════════════════════════════════════════════════
# DATABASE & CACHE
# ══════════════════════════════════════════════════════════════════════════════
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/invoicehive
REDIS_URL=rediss://default:password@redis-host:6379

# ══════════════════════════════════════════════════════════════════════════════
# JWT & AUTHENTICATION
# ══════════════════════════════════════════════════════════════════════════════
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ACCESS_SECRET=your_jwt_access_secret_min_32_chars_required_for_production_use_only
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_32_chars_required_for_production_use_only
COOKIE_SECRET=your_cookie_secret_min_32_chars_required_for_production_use_only

# ══════════════════════════════════════════════════════════════════════════════
# SERVICE-TO-SERVICE COMMUNICATION
# ══════════════════════════════════════════════════════════════════════════════
INTERNAL_SECRET=your_internal_service_secret_min_32_chars_for_production

# ══════════════════════════════════════════════════════════════════════════════
# OAUTH - GOOGLE
# ══════════════════════════════════════════════════════════════════════════════
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost/api/auth/oauth/google/callback

# ══════════════════════════════════════════════════════════════════════════════
# OAUTH - GITHUB
# ══════════════════════════════════════════════════════════════════════════════
HUB_CLIENT_ID=your_github_client_id
HUB_CLIENT_SECRET=your_github_client_secret
HUB_CALLBACK_URL=http://localhost/api/auth/oauth/github/callback

# ══════════════════════════════════════════════════════════════════════════════
# EMAIL (SMTP)
# ══════════════════════════════════════════════════════════════════════════════
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_specific_password
EMAIL_FROM=noreply@invoicehive.io

# ══════════════════════════════════════════════════════════════════════════════
# AWS S3 (Object Storage)
# ══════════════════════════════════════════════════════════════════════════════
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_S3_BUCKET=invoicehive-bucket-name
STORAGE_PUBLIC_URL=https://s3.amazonaws.com/invoicehive-bucket-name

# ══════════════════════════════════════════════════════════════════════════════
# RABBITMQ
# ══════════════════════════════════════════════════════════════════════════════
RABBITMQ_USER=guest
RABBITMQ_PASS=guest

# ══════════════════════════════════════════════════════════════════════════════
# RAZORPAY (Payment Gateway)
# ══════════════════════════════════════════════════════════════════════════════
RAZORPAY_KEY_ID=rzp_test_key_id
RAZORPAY_KEY_SECRET=rzp_test_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# ══════════════════════════════════════════════════════════════════════════════
# NGINX CONFIGURATION (for different environments)
# ══════════════════════════════════════════════════════════════════════════════
API_DOMAIN=api.example.com
APP_DOMAIN=example.com
ALLOWED_ORIGIN_1=https://example.com
ALLOWED_ORIGIN_2=https://www.example.com
ALLOWED_ORIGIN_3=https://api.example.com

# ══════════════════════════════════════════════════════════════════════════════
# DOCKER
# ══════════════════════════════════════════════════════════════════════════════
DOCKER_USERNAME=your_docker_hub_username
